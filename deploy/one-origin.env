# One origin on this machine (docs/GUIDE.md, "One origin (optional)"), read after .env:
#   docker compose --env-file .env --env-file deploy/one-origin.env up -d
# Django at http://localhost:8090/, the n8n editor at /n8n/, the preview at http://preview.localhost:8090.
COMPOSE_PROFILES=one-origin
GATEWAY_PORT=8090
BPMN8N_PUBLIC_URL=http://localhost:8090
N8N_PATH=/n8n/
N8N_EDITOR_BASE_URL=http://localhost:8090/n8n/
N8N_WEBHOOK_URL=http://localhost:8090/
N8N_PUBLIC_URL=/n8n
N8N_PREVIEW_URL=http://preview.localhost:8090
N8N_PREVIEW_SECURE_COOKIE=false
