      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2520,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "options": {
          "systemMessage": "You draft for the Data Protection Officer, who reviews, corrects and sends it. Plain, factual, no invented facts.\n\nYou prepare work for a person, who reviews it and takes the decision: never present your answer as a final decision. Use only the data you are given. Explain briefly how you reached your answer, so the person can check it, and say plainly when the data is not enough."
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
