      "Review and Send to Garante": {"authority_sent": true, "final_text": "sent"},
      "Inform Data Subjects": {"people_informed": true, "channel": "letter"}
    },
    "expect": {
      "visits": ["Review and Send to Garante", "Inform Data Subjects"],
      "ends": "Record in Breach Register",
      "variables": {"authority_notified": true}
    }
  },
